# Copy to .env (gitignored). Never commit real keys.
# LLM via Groq (OpenAI-compatible). Without a key the app runs and fails safe (rule layer + fixed questions).
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=8
# Demo only, used ONLY when no key/model is set: a fixed keyword heuristic stands in for the
# urgency model so the "routine" outcome can be demonstrated. Off by default. Never for real use.
DEMO_LLM_STANDIN=false

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_MINUTES=120

# App
DATABASE_URL=sqlite:///./lifeline.db
FRONTEND_ORIGIN=http://localhost:5173
CLINIC_TZ=Asia/Kolkata
DEMO_CITY=Chennai
MORNING_WINDOW=09:00-12:00
AFTERNOON_WINDOW=14:00-17:00
RESERVED_URGENT=2
HOLD_MINUTES=10
WALKIN_POLICY=after_booked
ALERT_AMBER_SECONDS=180
ALERT_RED_SECONDS=300
EMERGENCY_NUMBERS=112,108
EHR_BACKEND=local

# Demo seed (synthetic data only)
SEED_DEMO=true
SEED_PASSWORD=Password123!
# Dev-only endpoints (/triage/test-scenario)
DEV_ENDPOINTS=true
# Person A's original unauthenticated kiosk endpoints (off by default)
ENABLE_LEGACY_KIOSK=false
